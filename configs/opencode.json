{
  "$schema": "https://opencode.ai/config.json",
  "model": "colibri-local/parable-qwen3-4b",
  "plugin": [],
  "providers": {
    "local-ollama": {
      "name": "Ollama (Local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B"
        },
        "qwen3-coder-4b-16k:latest": {
          "name": "Qwen3-Coder 4B (16K)"
        }
      }
    },
    "colibri-local": {
      "name": "Colibri (Local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "headerTimeout": 1800000,
        "chunkTimeout": 1800000,
        "timeout": 1800000
      },
      "models": {
        "olmoe-colibri": {
          "modelID": "olmoe-colibri",
          "name": "OLMoE 1B-7B (Colibri)",
          "capabilities": {
            "tools": false,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen3-coder-30b-a3b-colibri": {
          "modelID": "qwen3-coder-30b-a3b-colibri",
          "name": "Qwen3-Coder-30B-A3B (Colibri)",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 8192,
            "output": 2048
          }
        },
        "parable-qwen3-4b": {
          "modelID": "parable-qwen3-4b",
          "name": "Parable Qwen3-4B (Colibri, CUDA)",
          "limit": {
            "context": 4096,
            "output": 1024
          },
          "capabilities": {
            "tools": false,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "agents": {
    "olmoe": {
      "description": "Minimal text-only agent for OLMoE",
      "mode": "primary",
      "model": "colibri-local/olmoe-colibri",
      "system": "You are a helpful assistant. Answer in plain text. Do not use tools.",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "qwen": {
      "description": "Qwen3-Coder-30B via Colibri",
      "mode": "primary",
      "model": "colibri-local/qwen3-coder-30b-a3b-colibri",
      "system": "You are a coding assistant. Use tools when they help. Answer concisely.",
      "temperature": 0.1,
      "top_p": 0.8
    },
    "parable": {
      "description": "Parable Qwen3-4B via Colibri (CUDA)",
      "mode": "primary",
      "model": "colibri-local/parable-qwen3-4b",
      "temperature": 0.1,
      "top_p": 0.8,
      "system": "You are a coding assistant. Answer concisely."
    }
  }
}